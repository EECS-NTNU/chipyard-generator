#!/bin/sh
set -eu

launcher=$0
while [ -L "$launcher" ]; do
    directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
    launcher=$(readlink "$launcher")
    case $launcher in
        /*) ;;
        *) launcher=$directory/$launcher ;;
    esac
done
directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -cp "$directory/lib/*" chipyard.generator.cli.Presolve "$@"
